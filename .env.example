# Copy to .env and fill in. NEVER commit .env.

# Simulator starting cash (terminal.py --sim)
STARTING_EQUITY=5000
# --- Rotation planner (plan.py) ---
# Optional. With a key, plan.py asks Claude for the plan; without it the
# rule-based planner runs. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
ROTATION_MODEL=claude-opus-5-5
ROTATION_EFFORT=high
# Optional: adds Alpha Vantage NEWS_SENTIMENT as a news source (free key at alphavantage.co)
ALPHAVANTAGE_API_KEY=
# Sizing guard-rails (see config.py for the rest)
ROTATION_MAX_POSITIONS=4
ROTATION_MAX_WEIGHT=0.35
ROTATION_MAX_BUYS=3
ROTATION_STOP_PCT=8

# --- Live desk (terminal.py): IBKR via TWS / IB Gateway on this machine ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497 paper / 7496 live (TWS); 4002 paper / 4001 live (Gateway)
IBKR_CLIENT_ID=7
IBKR_ACCOUNT=
IBKR_MARKET_DATA=delayed  # live needs a market-data subscription
# Telegram signals + commands (@BotFather for the token; your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# signal | manual | auto
WAVE_MODE=signal
ACCOUNT_TYPE=cash
WAVE_MIN_PRICE=1.0
WAVE_MAX_PRICE=20.0
WAVE_MIN_REL_VOL=3.0
WAVE_MIN_CHANGE_PCT=5.0
WAVE_RISK_PCT=1.5
WAVE_MAX_OPEN=3
WAVE_STOP_PCT=6
WAVE_TRAIL_PCT=8
WAVE_MAX_DAILY_LOSS_PCT=4
WAVE_EXIT_BEFORE_CLOSE_MIN=0
