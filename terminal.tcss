/* Wave desk — one quiet navy surface, colour only where it carries meaning:
   sea-green gains, coral losses, amber for a wave that just broke. */

Screen {
    background: #0e1420;
    color: #d6deea;
    layout: vertical;
}

#topbar {
    height: 3;
    padding: 0 2;
    background: #121a2a;
    border-bottom: solid #243049;
    content-align: left middle;
}

#body {
    layout: horizontal;
    height: 1fr;
}

#left, #right {
    layout: vertical;
    height: 1fr;
}
#left  { width: 3fr; }
#right { width: 2fr; }

Pane {
    border: round #243049;
    border-title-color: #7c8ba3;
    border-title-style: none;
    padding: 0 1;
    height: 1fr;
}
Pane:focus-within {
    border: round #5aa9ff;
    border-title-color: #d6deea;
}

#waves      { height: 3fr; }
#detail     { height: 2fr; }
#positions  { height: 2fr; }
#orders     { height: 1fr; min-height: 5; }
#log        { height: 2fr; }

DataTable {
    background: transparent;
    height: 1fr;
    scrollbar-size: 1 1;
}
DataTable > .datatable--header {
    background: transparent;
    color: #7c8ba3;
    text-style: none;
}
DataTable > .datatable--cursor {
    background: #243049;
    color: #ffffff;
}
DataTable:focus > .datatable--cursor {
    background: #2b4a7a;
}

RichLog {
    background: transparent;
    scrollbar-size: 1 1;
}

Static.detail-body {
    padding: 0 1;
}

Footer {
    background: #121a2a;
    color: #7c8ba3;
}
Footer > .footer--key {
    background: #243049;
    color: #d6deea;
}

/* ---------- modals ---------- */
ModalScreen {
    align: center middle;
    background: rgba(5, 8, 14, 0.72);
}
.dialog {
    width: 64;
    max-height: 90%;
    background: #162032;
    border: round #5aa9ff;
    padding: 1 2;
}
.dialog-wide { width: 100; }
.dialog .title {
    text-style: bold;
    margin-bottom: 1;
}
.dialog .hint {
    color: #7c8ba3;
    margin-bottom: 1;
}
.dialog Label {
    margin-top: 1;
}
.dialog Input {
    background: #0e1420;
    border: tall #243049;
}
.dialog Input:focus {
    border: tall #5aa9ff;
}
.dialog .buttons {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: right middle;
}
.dialog Button {
    margin-left: 1;
    min-width: 12;
}
Button.-primary {
    background: #2b4a7a;
    color: #ffffff;
    border: none;
}
Button.-primary:hover { background: #5aa9ff; color: #0e1420; }
Button.-error {
    background: #5a2a2a;
    color: #ffffff;
    border: none;
}
Button.-error:hover { background: #ff6b6b; color: #0e1420; }
Button.-default {
    background: #243049;
    color: #d6deea;
    border: none;
}
.warn {
    color: #f5b544;
}
.live-banner {
    background: #5a2a2a;
    color: #ffffff;
    padding: 0 1;
    margin-bottom: 1;
}
